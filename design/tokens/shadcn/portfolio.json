{
  "$description": "Тема портфолио: дефолтная нейтральная тема shadcn/ui, присланная владельцем 2026-08-02 в формате oklch и переведённая в hex без изменения значений. Совпадает с темой, применённой на ui.shadcn.com. Группы shape/density/typography не трогались.",
  "color": {
    "background": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "foreground": {
      "$type": "color",
      "$value": "#0a0a0a"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "card-foreground": {
      "$type": "color",
      "$value": "#0a0a0a"
    },
    "popover": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "popover-foreground": {
      "$type": "color",
      "$value": "#0a0a0a"
    },
    "primary": {
      "$type": "color",
      "$value": "#171717"
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "#fafafa"
    },
    "secondary": {
      "$type": "color",
      "$value": "#f5f5f5"
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": "#171717"
    },
    "muted": {
      "$type": "color",
      "$value": "#f5f5f5"
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "#737373"
    },
    "accent": {
      "$type": "color",
      "$value": "#f5f5f5"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "#171717"
    },
    "destructive": {
      "$type": "color",
      "$value": "#e7000b"
    },
    "border": {
      "$type": "color",
      "$value": "#e5e5e5"
    },
    "input": {
      "$type": "color",
      "$value": "#e5e5e5"
    },
    "ring": {
      "$type": "color",
      "$value": "#a1a1a1"
    },
    "chart-1": {
      "$type": "color",
      "$value": "#d4d4d4"
    },
    "chart-2": {
      "$type": "color",
      "$value": "#737373"
    },
    "chart-3": {
      "$type": "color",
      "$value": "#525252"
    },
    "chart-4": {
      "$type": "color",
      "$value": "#404040"
    },
    "chart-5": {
      "$type": "color",
      "$value": "#262626"
    },
    "sidebar": {
      "$type": "color",
      "$value": "#fafafa"
    },
    "sidebar-foreground": {
      "$type": "color",
      "$value": "#0a0a0a"
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": "#171717"
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": "#fafafa"
    },
    "sidebar-accent": {
      "$type": "color",
      "$value": "#f5f5f5"
    },
    "sidebar-accent-foreground": {
      "$type": "color",
      "$value": "#171717"
    },
    "sidebar-border": {
      "$type": "color",
      "$value": "#e5e5e5"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": "#a1a1a1"
    }
  },
  "shape": {
    "radius": {
      "$type": "dimension",
      "$value": "0.625rem"
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 0.6)"
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 0.8)"
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "var(--radius)"
    },
    "radius-xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 1.4)"
    },
    "radius-2xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 1.8)"
    },
    "radius-3xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 2.2)"
    },
    "radius-4xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 2.6)"
    }
  },
  "density": {
    "spacing": {
      "$type": "dimension",
      "$value": "0.25rem"
    }
  },
  "typography": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "\"Inter Variable\", \"Inter\", ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\""
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
    },
    "text-xs": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "text-xs--line-height": {
      "$type": "number",
      "$value": "calc(1 / 0.75)"
    },
    "text-sm": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "text-sm--line-height": {
      "$type": "number",
      "$value": "calc(1.25 / 0.875)"
    },
    "text-base": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "text-base--line-height": {
      "$type": "number",
      "$value": "calc(1.5 / 1)"
    },
    "text-lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "text-lg--line-height": {
      "$type": "number",
      "$value": "calc(1.75 / 1.125)"
    },
    "text-xl": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "text-xl--line-height": {
      "$type": "number",
      "$value": "calc(1.75 / 1.25)"
    },
    "text-2xl": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "text-2xl--line-height": {
      "$type": "number",
      "$value": "calc(2 / 1.5)"
    },
    "tracking-tight": {
      "$type": "dimension",
      "$value": "-0.022em"
    }
  }
}