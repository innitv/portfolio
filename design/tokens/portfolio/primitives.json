{
  "$description": "Тиер 1 — примитивы портфолио. Сырые значения без контекста: палитра, шкалы пространства и кеглей, длительности, кривые, гарнитуры, толщины, слои. Ни один продуктовый стиль не ссылается сюда напрямую — только через semantic.json. Снято инвентаризацией 2026-09-13 из src/styles, значения не изменялись.",
  "color": {
    "ink": {
      "900": { "$type": "color", "$value": "#0b0b0b", "$description": "Чернила — базовый тёмный портфолио." }
    },
    "paper": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "Бумага: текст и плоскости на чернилах и кобальте." },
      "50": { "$type": "color", "$value": "#fdfdfc", "$description": "Поле страницы кейса — теплее чистой бумаги." }
    },
    "cobalt": {
      "600": { "$type": "color", "$value": "#044ab3", "$description": "Кобальт — синий экран компании и переходы." }
    },
    "grey": {
      "500": { "$type": "color", "$value": "#8a8a8a", "$description": "Приглушённый серый на чернильном фоне." }
    },
    "sky": {
      "300": { "$type": "color", "$value": "#9bb8e8", "$description": "Голубой отклика на наведение." }
    },
    "signal": {
      "red-500": { "$type": "color", "$value": "#e11d2e", "$description": "Красный светофора заезда." },
      "green-500": { "$type": "color", "$value": "#27c46b", "$description": "Зелёный светофора заезда." }
    },
    "alpha-paper": {
      "850": { "$type": "color", "$value": "rgba(255, 255, 255, 0.85)" },
      "800": { "$type": "color", "$value": "rgba(255, 255, 255, 0.8)" },
      "550": { "$type": "color", "$value": "rgba(255, 255, 255, 0.55)" },
      "450": { "$type": "color", "$value": "rgba(255, 255, 255, 0.45)" },
      "300": { "$type": "color", "$value": "rgba(255, 255, 255, 0.3)" },
