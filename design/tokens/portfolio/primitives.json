      "040": { "$type": "color", "$value": "rgba(11, 11, 11, 0.04)" }
    }
  },
  "space": {
    "$description": "Шкала пространства, кратная четырём. Инвентаризация нашла шестнадцать значений отступов, шесть из них вне ряда (6, 9, 10, 13, 14, 18); 13.09.2026 они сведены к ступеням по правилу «ближайшая, при равенстве вверх». Кратность держит yarn tokens:check.",
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "15": { "$type": "dimension", "$value": "60px" },
    "18": { "$type": "dimension", "$value": "72px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "30": { "$type": "dimension", "$value": "120px" },
    "45": { "$type": "dimension", "$value": "180px" }
  },
  "breakpoint": {
    "$description": "Точки перелома раскладки. Выбраны владельцем 14.09.2026 из пяти несогласованных границ, стоявших в CSS (599, 639, 899/900, 1024, 1199): mobile — телефон, tablet — планшет и узкий ноут, desktop — полная раскладка. Медиазапрос пишется числом (CSS-переменная внутри @media не работает), а кратность шкале держит yarn tokens:check.",
    "mobile": { "$type": "dimension", "$value": "640px", "$description": "Ниже — одна колонка, поле 20, приёмы с горизонталью сняты." },
    "tablet": { "$type": "dimension", "$value": "900px", "$description": "Ниже — нет бокового рельса и парных колонок; выше — раскладка с рельсом." },
    "desktop": { "$type": "dimension", "$value": "1200px", "$description": "Ниже — поле 40 и имена компаний колонкой; выше — макетная раскладка рядом." }
  },
  "size": {
    "$description": "Кегли, вынесенные из переменных поверхностей. Шкала кратна четырём (13.09.2026): рядом стояли 13 и 14, 15 и 16, 18 и 19 — различия, которых никто не закладывал. Плавающие величины остаются формулами на своём тиере, у них проверяются только границы clamp.",
    "caption": { "$type": "dimension", "$value": "12px" },
    "meta": { "$type": "dimension", "$value": "12px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "lead": { "$type": "dimension", "$value": "20px" },
    "sub": { "$type": "dimension", "$value": "24px" },
    "part": { "$type": "dimension", "$value": "32px" },
    "value": { "$type": "dimension", "$value": "44px" },
    "title": { "$type": "dimension", "$value": "96px" }
  },
  "line": {
