{
  "name": "siteportfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "deploy": "yarn build && node tools/deploy-portfolio-regru.mjs",
    "deploy:dry-run": "yarn build && node tools/deploy-portfolio-regru.mjs --dry-run",
    "qa": "yarn build && playwright test",
    "qa:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "qa:case-grid": "node tests/case-grid.check.mjs",
    "tokens:check": "node tests/tokens.check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "framer-motion": "12.40.0",
    "lenis": "^1.3.26",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.10"
  }
}
